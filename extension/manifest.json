{
  "manifest_version": 3,
  "name": "Tailnet Finder",
  "version": "1.0.0",
  "description": "Find a Tailscale name with phrase and length filters. Stop and notify on a match.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tailnet Finder",
    "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}
  },
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}
}
